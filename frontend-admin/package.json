{
  "name": "quran-platform-admin",
  "private": true,
  "version": "1.0.0-rc1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:authz-model": "npx tsx scripts/check-authorization-model.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "manifest:generate": "npx tsx scripts/generate-release-manifest.ts",
    "gate:functional": "npx tsx scripts/record-gate-result.ts functional \"npm run typecheck && npm run check:authz-model && npm run build\"",
    "gate:security": "npx tsx scripts/record-gate-result.ts security \"docker exec quran_platform_app php artisan test tests/Feature/MfaAndSessionsTest.php tests/Feature/PhoneOtpTest.php tests/Feature/DeviceTrustTest.php tests/Feature/RateLimitingTest.php tests/Feature/CorrelationIdMiddlewareTest.php tests/Feature/AuditLoggingMiddlewareTest.php tests/Feature/AdminAuthorizationTest.php\"",
    "gate:e2e": "echo 'Running E2E Playwright Gate verification...'",
    "gate:performance": "npx tsx scripts/run-performance-gate.ts",
    "gate:reliability": "echo 'Running Reliability Gate verification...'",
    "gate:observability": "echo 'Running Observability Gate verification...'",
    "gate:all": "npm run gate:functional && npm run gate:security && npm run gate:performance && npm run manifest:generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "i18next": "^23.15.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.2",
    "react-player": "^2.16.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.3",
    "sonner": "^1.7.4",
    "sweetalert2": "^11.14.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
